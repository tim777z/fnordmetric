# FnordMetric runtime configuration
# Copy to .env and adjust for your environment. Never commit a real .env file.

FNORDMETRIC_HOST=0.0.0.0
FNORDMETRIC_PORT=8080

# Postgres backend connection (consumed by postgresconnection)
FNORDMETRIC_PG_HOST=127.0.0.1
FNORDMETRIC_PG_PORT=5432
FNORDMETRIC_PG_DATABASE=fnordmetric
FNORDMETRIC_PG_USER=fnordmetric
FNORDMETRIC_PG_PASSWORD=change-me

# Optional MySQL backend connection
FNORDMETRIC_MYSQL_HOST=127.0.0.1
FNORDMETRIC_MYSQL_PORT=3306
FNORDMETRIC_MYSQL_DATABASE=fnordmetric
FNORDMETRIC_MYSQL_USER=fnordmetric
FNORDMETRIC_MYSQL_PASSWORD=change-me